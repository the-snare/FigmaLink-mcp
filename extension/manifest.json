{
  "manifest_version": 3,
  "name": "FigmaLink",
  "description": "Companion extension for the figmalink-mcp server: it pairs with a local loopback bridge and drives the Figma canvas through the DevTools Protocol. Ships unpaired and does nothing until you point it at your own MCP server.",
  "version": "0.26.0",
  "permissions": ["debugger", "activeTab", "storage", "offscreen"],
  "host_permissions": ["https://www.figma.com/*"],
  "background": { "service_worker": "background/sw.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FigmaLink",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
